# 복사해서 사용: cp .env.example .env
# .env는 gitignore 대상이다. 실제 secret을 이 example 파일에 적지 않는다.

# PostgreSQL (docker-compose db 서비스)
POSTGRES_USER=autocert
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=autocert
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-12-chars
BOOTSTRAP_ADMIN_USERNAME=admin
SESSION_TTL=8h
# 백엔드 (compose가 DATABASE_URL을 위 값으로 조립한다. 로컬 단독 실행 시 직접 지정:)
# HTTP_ADDR=:8080
# DATABASE_URL=postgres://autocert:change-me-dev-only@localhost:5432/autocert?sslmode=disable
