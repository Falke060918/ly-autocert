{
  "agent": "orchestrator",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "medium",
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "autoMemoryEnabled": true,
  "sandbox": {
    "enabled": true
  },
  "statusLine": {
    "type": "command",
    "command": "s=scripts/statusline.sh; d=${CLAUDE_PROJECT_DIR:-$PWD}; [ -f \"$d/$s\" ] || { d=$PWD; p=; while [ ! -f \"$d/$s\" ]; do [ \"$d\" != \"$p\" ] || { echo claude; exit; }; p=$d; d=${d%/*}; done; }; exec bash \"$d/$s\"",
    "refreshInterval": 2
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(rtk:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git init:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git pull:*)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh release:*)",
      "Bash(gh auth status:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(pip install:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(sleep *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(base64 *)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(bash scripts/*)",
      "Bash(bash -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(gh repo view:*)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(* git push *--force*)",
      "Bash(* git push -f*)",
      "Bash(* git push * -f*)",
      "Bash(* git push *+*)",
      "Bash(* push *--force*)",
      "Bash(* push -f*)",
      "Bash(* push * -f*)",
      "Bash(* push *+*)",
      "Bash(* push -*f)",
      "Bash(* push -*f *)",
      "Bash(* push * -*f)",
      "Bash(* push * -*f *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Bash(* git reset --hard*)",
      "Bash(* git clean -*f*)",
      "Bash(rtk git reset --hard:*)",
      "Bash(rtk git clean:*)",
      "Bash(python* -c*)",
      "Bash(* python* -c*)",
      "Bash(node -e*)",
      "Bash(node --eval*)",
      "Bash(node -p*)",
      "Bash(node --print*)",
      "Bash(* node -e*)",
      "Bash(* node --eval*)",
      "Bash(* node -p*)",
      "Bash(* node --print*)",
      "Bash(npx *)",
      "Bash(* npx *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/compact-snapshot.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/compact-snapshot.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/compact-resume.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/session-markers.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          },
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/session-banner.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/perf-log.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/perf-log.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          },
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/ko-wordcheck-hook.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          },
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/nudge-reminder.sh; [ -f \"$b\" ] && exec bash \"$b\"; exit 0"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/skill-health.sh; [ -f \"$b\" ] || exit 0; in=$(head -c 65536 2>/dev/null); n=$(printf '%s' \"$in\" | grep -o '\"skill\":\"[^\"]*\"' | head -n 1 | cut -d'\"' -f4); [ -n \"$n\" ] || n=$(printf '%s' \"$in\" | grep -o '\"command\":\"[^\"]*\"' | head -n 1 | cut -d'\"' -f4); n=${n%% *}; n=${n##*/}; [ -n \"$n\" ] && bash \"$b\" record \"$n\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/perf-log.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/perf-log.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/fanout.sh; [ -f \"$b\" ] && bash \"$b\" 1; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=${CLAUDE_PROJECT_DIR:-$PWD}; b=$d/scripts/learn-harvest.sh; [ -f \"$b\" ] && bash \"$b\"; exit 0"
          }
        ]
      }
    ]
  }
}
