{
  "description": "Codex starter: state, snapshots, timings and learning review pointers.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/starter.py\" hook",
            "commandWindows": "powershell.exe -NoProfile -EncodedCommand ",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
